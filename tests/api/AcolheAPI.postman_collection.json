  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login Válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful POST request\", function () {\r\n    pm.expect(pm.response.code).to.eql(200);\r\n});\r\n\r\npm.test( \"Validação da mensagem\",  function(){\r\n    pm.expect(pm.response.json()).to.have.property(\"mensagem\");\r\n})\r\n\r\npm.test(\"Validação do tipo do id\", function () {\r\n    pm.expect(pm.response.json().usuario.id).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Validação do tipo do nome\", function () {\r\n    pm.expect(pm.response.json().usuario.nome).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"Validação do tipo do papel\", function () {\r\n    pm.expect(pm.response.json().usuario.papel).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Senha não deve ser retornada\", function () {\r\n    pm.expect(pm.response.json().usuario)\r\n        .to.not.have.property(\"senha\");\r\n});\r\n\r\npm.test(\"Validação da mensagem de sucesso\", function () {\r\n    pm.expect(pm.response.json().mensagem)\r\n        .to.eql(\"Login realizado com sucesso\");\r\n});\r\n\r\nconst requestBody = JSON.parse(pm.request.body.raw);\r\n\r\npm.test(\"Validação do email do usuário\", function () {\r\n    pm.expect(pm.response.json().usuario.email)\r\n        .to.eql(requestBody.email);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email_login}}\",\n    \"senha\": \"{{senha_login}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/usuario/store",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuario",
                "store"
              ]
            }
          },
          "response": []
        },
